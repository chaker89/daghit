{
  "name": "@daghit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test test/*.test.ts",
    "grant-owner": "node --env-file-if-exists=.env.local --import tsx src/grant-owner.ts"
  },
  "dependencies": {
    "@daghit/typings": "*",
    "koa": "^3.3.0",
    "@koa/router": "^15.7.1",
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1"
  }
}
