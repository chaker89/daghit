PORT=3000
# Set a cryptographically random value of at least 32 bytes in .env.local. Never use a mobile EXPO_PUBLIC variable.
JWT_SECRET=
JWT_TTL_SECONDS=3600
DATABASE_PATH=./data/daghit.sqlite
# Comma-separated browser origins; native Android/iOS clients do not require CORS.
CORS_ORIGINS=http://localhost:8081
