{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/.expo/**/*",
      "!{projectRoot}/data/**/*",
      "!{projectRoot}/.env.local",
      "!{projectRoot}/node_modules/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/lerna.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.nvmrc",
      {
        "runtime": "node --version"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "sharedGlobals",
        {
          "env": "EXPO_PUBLIC_API_URL"
        }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "sharedGlobals"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "sharedGlobals"
      ]
    }
  }
}
